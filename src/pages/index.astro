---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { calculators } from '../data/calculators-meta.js';
import { webApplicationJsonLd } from '../utils/seo.js';

const title = '머니장부 – 한국 금융 계산기 모음 | 2026년 기준';
const description =
	'퇴직금, 대출이자, 예금이자, 연봉실수령액, 연말정산, 실업급여, 취득세, 육아휴직급여까지 2026년 요율 반영 무료 계산기 모음.';
const pageUrl = new URL('/', Astro.site).toString();

const jsonLd = webApplicationJsonLd({ name: '머니장부', description, url: pageUrl });
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
	<h1>머니장부</h1>
	<p>
		퇴직금부터 연말정산, 실업급여, 부동산 취득세까지 — 2026년 최신 요율을 반영한 8종의 금융
		계산기를 한곳에 모았습니다. 회원가입 없이 바로 계산하고, 계산 근거와 관련 제도까지 함께
		확인하세요.
	</p>

	<AdSlot position="top" />

	<section class="content-section">
		<h2>계산기 목록</h2>
		<div class="calc-grid">
			{
				calculators.map((c) => (
					<a class="calc-tile" href={`/${c.slug}/`}>
						<span class="calc-tile__no">No. {c.no} · {c.ledgerLabel}</span>
						<h3 class="calc-tile__title">{c.title}</h3>
						<p class="calc-tile__desc">{c.desc}</p>
					</a>
				))
			}
		</div>
	</section>

	<AdSlot position="middle" />

	<section class="content-section">
		<h2>머니장부는 이런 사이트입니다</h2>
		<p>
			머니장부는 급여, 대출, 예금, 세금, 사회보험처럼 살면서 한 번쯤 계산해봐야 하는 금융
			항목을 빠르고 정확하게 확인할 수 있도록 만든 계산기 모음 사이트입니다. 모든 계산기는
			2026년 기준 국민연금·건강보험·고용보험 요율, 최저임금, 소득세 과세표준 등 최신 공개
			자료를 근거로 만들어졌으며, 요율이 바뀌면 계산 로직도 함께 갱신합니다.
		</p>
		<p>
			각 계산기 페이지에는 계산 결과뿐 아니라 산정 공식, 근거 법령, 자주 묻는 질문까지 함께
			담아 "왜 이 금액이 나왔는지" 이해할 수 있도록 구성했습니다. 다만 모든 계산 결과는
			이해를 돕기 위한 참고용 수치이며, 개인의 구체적인 상황(감면·특례 대상 여부, 회사별 규정
			등)에 따라 실제 금액과 차이가 날 수 있습니다. 중요한 의사결정 전에는 반드시 관련 기관
			(국민연금공단, 국세청 홈택스, 고용노동부, 위택스 등)의 공식 계산 결과를 함께 확인하세요.
		</p>
	</section>

	<AdSlot position="bottom" />
</BaseLayout>
