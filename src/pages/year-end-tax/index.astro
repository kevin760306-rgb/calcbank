---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import FaqSection from '../../components/FaqSection.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { webApplicationJsonLd, faqJsonLd } from '../../utils/seo.js';

const title = '연말정산 환급금 계산기 – 2026년 기준 | 머니장부';
const description =
	'총급여, 부양가족, 신용카드 사용액, 연금계좌 납입액을 입력해 예상 연말정산 환급 또는 추가 납부 세액을 계산합니다.';
const pageUrl = new URL('/year-end-tax/', Astro.site).toString();

const faqs = [
	{
		q: '연말정산 환급금은 어떻게 결정되나요?',
		a: '1년 동안 매달 원천징수된 세금(기납부세액)과, 각종 소득·세액공제를 반영해 다시 계산한 실제 결정세액을 비교합니다. 기납부세액이 더 많으면 차액을 돌려받고(환급), 결정세액이 더 많으면 추가로 납부합니다.',
	},
	{
		q: '신용카드 소득공제는 어떻게 계산되나요?',
		a: '1년간 신용카드 등 사용액이 총급여의 25%를 넘는 부분에 대해 일정 비율을 소득공제합니다. 체크카드·현금영수증(30%), 전통시장·대중교통(40%)은 신용카드(15%)보다 공제율이 높지만, 이 계산기는 입력을 단순화하기 위해 전액 신용카드 사용률(15%)로 가정합니다. 실제로는 결제수단별로 공제율이 달라 이 계산기보다 유리할 수 있습니다.',
	},
	{
		q: '연금저축·IRP 세액공제는 얼마나 받을 수 있나요?',
		a: '연금저축과 IRP를 합쳐 연 900만원까지 납입액의 16.5%(총급여 5,500만원 이하) 또는 13.2%(초과)를 세액공제 받을 수 있습니다. 900만원을 모두 채우면 최대 148만 5천원(16.5% 기준)까지 세액공제가 가능합니다.',
	},
	{
		q: '이 계산기가 반영하지 않는 항목이 있나요?',
		a: '의료비, 교육비, 기부금, 월세, 보험료 등 다양한 특별세액공제 항목은 반영하지 않았습니다. 해당 지출이 많다면 실제 환급액은 이 계산기 결과보다 클 수 있습니다. 정확한 금액은 국세청 홈택스 연말정산 미리보기 서비스를 이용하세요.',
	},
];

const jsonLd = [
	webApplicationJsonLd({ name: '연말정산 환급금 계산기', description, url: pageUrl }),
	faqJsonLd(faqs),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
	<h1>연말정산 환급금 계산기</h1>
	<p>총급여와 공제 항목을 입력하면 예상 환급/추징 세액을 계산합니다.</p>

	<CalculatorCard no="05" label="YEAR-END TAX">
		<form id="yeartax-form">
			<div class="field-grid">
				<div class="field">
					<label for="annualSalary">연간 총급여</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="annualSalary" required placeholder="40,000,000" />
						<span class="field__unit">원</span>
					</div>
				</div>
				<div class="field">
					<label for="dependents">부양가족 수(본인 포함)</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="dependents" required placeholder="1" />
						<span class="field__unit">명</span>
					</div>
				</div>
				<div class="field">
					<label for="childrenCount">8세 이상 자녀 수</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="childrenCount" placeholder="0" />
						<span class="field__unit">명</span>
					</div>
				</div>
				<div class="field">
					<label for="creditCardSpend">신용카드 등 연간 사용액</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="creditCardSpend" placeholder="0" />
						<span class="field__unit">원</span>
					</div>
				</div>
				<div class="field">
					<label for="pensionContribution">연금저축·IRP 납입액</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="pensionContribution" placeholder="0" />
						<span class="field__unit">원</span>
					</div>
				</div>
				<div class="field">
					<label for="alreadyWithheldTax">기납부세액(원천징수 합계)</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="alreadyWithheldTax" required placeholder="2,000,000" />
						<span class="field__unit">원</span>
					</div>
				</div>
			</div>
			<button type="submit" class="btn-calc">연말정산 계산하기</button>
		</form>

		<AdSlot position="top" />

		<div class="ledger-result" id="result">
			<div class="ledger-result__row">
				<span class="label">과세표준</span>
				<span class="value" id="r-taxable">-</span>
			</div>
			<div class="ledger-result__row">
				<span class="label">산출세액</span>
				<span class="value" id="r-calculated">-</span>
			</div>
			<div class="ledger-result__row">
				<span class="label">세액공제 합계</span>
				<span class="value" id="r-credit">-</span>
			</div>
			<div class="ledger-result__row">
				<span class="label">결정세액(지방세 포함)</span>
				<span class="value" id="r-final">-</span>
			</div>
			<div class="ledger-result__row ledger-result__row--total">
				<span class="label" id="r-result-label">예상 환급액</span>
				<span class="value" id="r-refund">-</span>
			</div>
			<div class="result-stamp-wrap">
				<div class="result-stamp" id="stamp">확인</div>
			</div>
		</div>

		<Disclaimer />
	</CalculatorCard>

	<article class="content-section">
		<h2>연말정산, 이렇게 계산됩니다</h2>
		<p>
			연말정산은 1년치 근로소득에 대해 이미 매달 낸 세금(기납부세액)과 실제로 확정된 세액(결정세액)의
			차이를 정산하는 절차입니다. 결정세액이 계산 과정은 크게 소득공제 단계와 세액공제 단계로
			나뉩니다.
		</p>
		<table>
			<tbody>
				<tr><th>1단계</th><td>총급여 − 근로소득공제 = 근로소득금액</td></tr>
				<tr><th>2단계</th><td>근로소득금액 − 인적공제 − 사회보험료공제 − 신용카드 등 소득공제 = 과세표준</td></tr>
				<tr><th>3단계</th><td>과세표준 × 세율 − 누진공제 = 산출세액</td></tr>
				<tr><th>4단계</th><td>산출세액 − 근로소득세액공제 − 자녀세액공제 − 연금계좌세액공제 − 표준세액공제 = 결정세액</td></tr>
			</tbody>
		</table>
		<p>
			이 계산기는 위 흐름을 그대로 따르되, 의료비·교육비·기부금·월세·보험료 세액공제 등 개인별로
			편차가 큰 항목은 반영하지 않은 간이 버전입니다. 신용카드 등 소득공제를 입력하면 표준세액공제
			(13만원) 대신 신용카드 공제가 적용되도록 자동으로 전환됩니다. 실제 연말정산에서는 특별소득공제·
			특별세액공제 항목을 종합적으로 비교해 유리한 방식을 선택할 수 있으므로, 정확한 금액은 국세청
			홈택스의 "연말정산 미리보기" 서비스로 다시 확인하는 것을 권장합니다.
		</p>
	</article>

	<AdSlot position="middle" />

	<FaqSection items={faqs} />

	<RelatedLinks slug="year-end-tax" />

	<AdSlot position="bottom" />
</BaseLayout>

<script>
	import { calcYearEndTax } from '../../lib/yearEndTax.js';
	import { attachCommaFormatting, parseNumber, formatWon } from '../../scripts/number-input.js';

	['annualSalary', 'creditCardSpend', 'pensionContribution', 'alreadyWithheldTax'].forEach((id) => {
		attachCommaFormatting(document.getElementById(id));
	});

	const form = document.getElementById('yeartax-form');
	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const annualSalary = parseNumber(document.getElementById('annualSalary').value);
		const dependents = Math.max(parseNumber(document.getElementById('dependents').value) || 1, 1);
		const childrenCount = parseNumber(document.getElementById('childrenCount').value);
		const creditCardSpend = parseNumber(document.getElementById('creditCardSpend').value);
		const pensionContribution = parseNumber(document.getElementById('pensionContribution').value);
		const alreadyWithheldTax = parseNumber(document.getElementById('alreadyWithheldTax').value);

		const result = calcYearEndTax({
			annualSalary,
			dependents,
			childrenCount,
			creditCardSpend,
			pensionContribution,
			alreadyWithheldTax,
		});

		document.getElementById('r-taxable').textContent = formatWon(result.taxableIncome);
		document.getElementById('r-calculated').textContent = formatWon(result.calculatedTax);
		const totalCredit =
			result.earnedIncomeTaxCredit + result.childTaxCredit + result.pensionTaxCredit + result.standardTaxCredit;
		document.getElementById('r-credit').textContent = `-${formatWon(totalCredit)}`;
		document.getElementById('r-final').textContent = formatWon(result.finalTaxWithLocal);

		const label = document.getElementById('r-result-label');
		const refundEl = document.getElementById('r-refund');
		if (result.refundOrDue >= 0) {
			label.textContent = '예상 환급액';
			refundEl.textContent = formatWon(result.refundOrDue);
		} else {
			label.textContent = '예상 추가 납부액';
			refundEl.textContent = formatWon(Math.abs(result.refundOrDue));
		}

		document.getElementById('result').classList.add('is-visible');
		const stamp = document.getElementById('stamp');
		stamp.classList.remove('is-visible');
		void stamp.offsetWidth;
		stamp.classList.add('is-visible');
	});
</script>
