---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculators } from '../../data/calculators-meta.js';

const title = '사이트 소개 | 머니장부';
const description = '머니장부가 만들어진 목적, 계산 방식, 데이터 근거와 한계를 소개합니다.';
const pageUrl = new URL('/about/', Astro.site).toString();

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	name: title,
	description,
	url: pageUrl,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
	<h1>사이트 소개</h1>

	<section class="content-section">
		<h2>머니장부를 만든 이유</h2>
		<p>
			퇴직금, 실수령액, 대출 이자, 세금처럼 살면서 여러 번 마주치는 금융 계산은 관련 법령과
			요율을 일일이 찾아보기 번거롭습니다. 머니장부는 이런 계산을 한곳에 모아, 입력만 하면
			바로 결과를 확인할 수 있도록 만든 계산기 모음 사이트입니다. 회원가입이나 개인정보
			입력 없이 누구나 바로 사용할 수 있습니다.
		</p>
	</section>

	<section class="content-section">
		<h2>제공 중인 계산기</h2>
		<ul>
			{calculators.map((c) => <li><a href={`/${c.slug}/`}>{c.title}</a> — {c.desc}</li>)}
		</ul>
	</section>

	<section class="content-section">
		<h2>계산 근거와 업데이트</h2>
		<p>
			모든 계산기는 국민연금공단, 국민건강보험공단, 고용노동부, 국세청, 행정안전부(지방세)
			등 공공기관이 공개한 2026년 기준 요율과 한도액을 근거로 만들었습니다. 국민연금
			보험료율, 최저임금, 실업급여 상·하한액처럼 매년 바뀌는 값은 별도 데이터 파일로 관리해,
			요율이 개정되면 계산 로직 전체를 뜯어고치지 않고도 반영할 수 있도록 설계했습니다.
		</p>
		<p>
			다만 이 사이트는 세무사·노무사·법률 전문가의 상담을 대체하지 않습니다. 연말정산, 취득세처럼
			개인 상황(공제 항목, 지역별 특례 등)에 따라 결과가 크게 달라지는 계산기는 가장 흔한
			경우를 기준으로 한 간이 계산기이며, 각 계산기 페이지 하단에 반영하지 않은 항목과 한계를
			구체적으로 안내하고 있습니다. 정확한 금액이 필요한 경우 반드시 관련 기관의 공식 계산
			결과나 전문가 상담을 함께 확인하세요.
		</p>
	</section>

	<section class="content-section">
		<h2>문의</h2>
		<p>
			오류 제보나 개선 제안은 <a href="mailto:contact@calcbank.kr">contact@calcbank.kr</a>으로
			보내주세요.
		</p>
	</section>
</BaseLayout>
