---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import FaqSection from '../../components/FaqSection.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { webApplicationJsonLd, faqJsonLd } from '../../utils/seo.js';

const title = '육아휴직 급여 계산기 – 2025년 개편 기준 | 머니장부';
const description =
	'2025년 개편된 3구간 정률제(1~3개월 250만원, 4~6개월 200만원, 7개월 이후 160만원 상한)를 반영한 육아휴직 급여 계산기.';
const pageUrl = new URL('/parental-leave/', Astro.site).toString();

const faqs = [
	{
		q: '2025년 육아휴직 제도가 어떻게 바뀌었나요?',
		a: '"육아지원 3법" 개정으로 두 가지가 달라졌습니다. 급여를 시기별 3구간 정률제로 올리고 복직 후 지급되던 사후지급금 제도를 폐지해 휴직 중 매달 전액을 받게 한 개편은 2025년 1월 1일부터, 최장 휴직 기간을 1년에서 1년 6개월로 늘린 개편은 2025년 2월 23일부터 시행되었습니다.',
	},
	{
		q: '통상임금이 낮으면 얼마를 받나요?',
		a: '계산된 금액이 하한액인 70만원보다 낮으면 70만원이 보장됩니다. 이 하한액은 2025년 개편 이후에도 그대로 유지되고 있습니다.',
	},
	{
		q: '육아휴직을 1년 6개월까지 무조건 쓸 수 있나요?',
		a: '아니요, 원칙적으로는 부모가 각각 3개월 이상 육아휴직을 사용해야 두 사람 모두 1년 6개월까지 쓸 수 있습니다. 다만 한부모 근로자나 중증장애아동(장애의 정도가 심한 장애인)을 양육하는 부모는 이 조건 없이 곧바로 1년 6개월까지 사용할 수 있습니다. 맞벌이 부부는 각자 1년 6개월씩 사용해 한 자녀에 대해 부모 합산 최대 3년까지 육아휴직을 쓸 수 있고, 육아휴직은 최대 4번까지 나누어 사용할 수 있습니다.',
	},
	{
		q: '부모가 같이 육아휴직을 쓰면 더 받을 수 있나요?',
		a: '자녀 생후 18개월 이내에 부모가 함께 또는 순차적으로 육아휴직을 사용하는 "6+6 부모육아휴직제"를 이용하면 첫 6개월간 통상임금 100%가 지급되며, 월 상한액이 1개월 차 250만원 → 2개월 차 250만원 → 3개월 차 300만원 → 4개월 차 350만원 → 5개월 차 400만원 → 6개월 차 450만원까지 단계적으로 올라갑니다. 7개월 차부터는 이 특례가 끝나고 일반 상한(160만원)이 적용됩니다. 한부모 근로자는 첫 3개월 상한액이 300만원으로 더 높습니다. 이 계산기는 부모 개별 신청 기준(일반 육아휴직급여)만 계산하므로, 6+6 특례나 한부모 특례 대상이라면 실제 수령액은 이 계산기 결과보다 많을 수 있습니다.',
	},
	{
		q: '육아휴직급여는 매달 자동으로 들어오고, 회사가 거부할 수도 있나요?',
		a: '급여는 자동 지급되지 않습니다. 휴직 중이라도 매달 고용센터에 신청해야 하며, 첫 신청은 육아휴직 시작일로부터 1개월이 지난 후부터 가능합니다. 반면 육아휴직 자체는 회사가 원칙적으로 거부할 수 없습니다. 남녀고용평등과 일·가정 양립 지원에 관한 법률에 따라 사업주는 요건을 갖춰 신청한 근로자에게 육아휴직을 허용해야 하고, 이를 이유로 한 해고나 불리한 처우는 금지되어 있습니다.',
	},
];

const jsonLd = [
	webApplicationJsonLd({ name: '육아휴직 급여 계산기', description, url: pageUrl }),
	faqJsonLd(faqs),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
	<h1>육아휴직 급여 계산기</h1>
	<p>통상임금과 휴직 예정 개월 수를 입력하면 2025년 개편 기준 월별·총 육아휴직급여를 계산합니다.</p>

	<CalculatorCard no="08" label="PARENTAL LEAVE PAY">
		<form id="parental-form">
			<div class="field-grid">
				<div class="field">
					<label for="ordinaryWage">월 통상임금</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="ordinaryWage" required placeholder="3,000,000" />
						<span class="field__unit">원</span>
					</div>
				</div>
				<div class="field">
					<label for="months">휴직 예정 기간</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="months" required placeholder="12" />
						<span class="field__unit">개월</span>
					</div>
				</div>
			</div>
			<button type="submit" class="btn-calc">육아휴직급여 계산하기</button>
		</form>

		<AdSlot position="top" />

		<div class="ledger-result" id="result">
			<div class="ledger-result__row">
				<span class="label">1~3개월 월 지급액</span>
				<span class="value" id="r-tier1">-</span>
			</div>
			<div class="ledger-result__row">
				<span class="label">4~6개월 월 지급액</span>
				<span class="value" id="r-tier2">-</span>
			</div>
			<div class="ledger-result__row">
				<span class="label">7개월 이후 월 지급액</span>
				<span class="value" id="r-tier3">-</span>
			</div>
			<div class="ledger-result__row ledger-result__row--total">
				<span class="label">총 예상 지급액</span>
				<span class="value" id="r-total">-</span>
			</div>
			<div class="result-stamp-wrap">
				<div class="result-stamp" id="stamp">확인</div>
			</div>
		</div>

		<Disclaimer />
	</CalculatorCard>

	<article class="content-section">
		<h2>육아휴직급여 계산 방법</h2>
		<p>
			육아휴직급여는 휴직한 달을 기준으로 세 구간에 걸쳐 다른 비율과 상한액이 적용됩니다. 월 지급액은
			"통상임금 × 지급률"과 "구간별 상한액" 중 더 낮은 금액이며, 계산된 금액이 하한액(70만원)보다
			낮으면 하한액을 지급합니다.
		</p>
		<table>
			<tbody>
				<tr><th>1~3개월</th><td>통상임금 100%, 월 상한 250만원</td></tr>
				<tr><th>4~6개월</th><td>통상임금 100%, 월 상한 200만원</td></tr>
				<tr><th>7개월 이후</th><td>통상임금 80%, 월 상한 160만원</td></tr>
			</tbody>
		</table>
		<p>
			2025년 개편("육아지원 3법")으로 휴직 급여의 25%를 복직 후 6개월 근무 시 일괄 지급하던
			사후지급금 제도가 폐지되어 휴직 중 매달 전액을 받을 수 있게 되었고(2025년 1월 1일 시행),
			육아휴직 최장 기간도 1년에서 1년 6개월로 늘었습니다(2025년 2월 23일 시행). 통상임금은
			근로기준법상 정기적·일률적으로 지급되는 임금(기본급, 직책수당 등)을 기준으로 하며, 회사마다
			포함 항목이 다를 수 있으므로 급여명세서의 통상임금 항목을 확인하는 것이 정확합니다.
		</p>
		<h3>예시로 계산해보면</h3>
		<p>
			월 통상임금 300만원인 근로자가 12개월간 육아휴직을 사용한다면, 1~3개월은 통상임금
			100%가 상한 250만원을 넘어 매달 250만원, 4~6개월도 상한 200만원이 적용돼 매달
			200만원, 7~12개월은 통상임금의 80%인 240만원이 상한 160만원을 넘어 매달 160만원이
			지급됩니다. 12개월을 합치면 750만원 + 600만원 + 960만원 = 2,310만원이 총 예상
			지급액입니다.
		</p>
	</article>

	<article class="content-section">
		<h2>관련 법령 및 기준</h2>
		<p>
			육아휴직 제도의 법적 근거는 두 갈래입니다. 육아휴직을 신청할 수 있는 요건과 최장 기간(원칙
			1년, 부모 각각 3개월 이상 사용 시 1년 6개월)은 남녀고용평등과 일·가정 양립 지원에 관한
			법률이 정하며, 이 기간 연장은 2025년 2월 23일부터 시행되었습니다. 반면 휴직 중 받는
			육아휴직급여의 구간별 지급률과 상한·하한액은 고용보험법 및 그 시행령에서 정하고 있고,
			3구간 정률제로의 개편과 사후지급금 폐지는 2025년 1월 1일부터 시행되었습니다. 이 계산기는
			두 법령에 따른 2025년 개편 기준 수치를 반영합니다.
		</p>
	</article>

	<article class="content-section">
		<h2>주의사항</h2>
		<p>다음과 같은 경우엔 실제 지급액이 이 계산기 결과와 다를 수 있습니다.</p>
		<ul>
			<li>이 계산기에 입력한 개월 수만큼 그대로 계산되지만, 실제로는 부모가 각각 3개월 이상 육아휴직을 사용해야 두 사람 모두 1년 6개월까지 쓸 수 있는 것이 원칙입니다. 한부모나 중증장애아동을 양육하는 경우가 아니라면, 한 부모만 사용할 때는 최장 기간이 1년(12개월)에 그칠 수 있습니다.</li>
			<li>통상임금 산정 기준(포함 수당 범위 등)은 회사마다 다를 수 있습니다.</li>
			<li>자녀 생후 18개월 이내 부모가 함께 또는 순차적으로 사용하는 "6+6 부모육아휴직제"와 한부모 특례는 상한액 구간이 이 계산기와 달라 별도로 계산해야 합니다.</li>
			<li>육아휴직급여는 매달 고용센터에 별도로 신청해야 지급되며, 자동으로 지급되지 않습니다.</li>
		</ul>
		<p>정확한 지급액과 신청 절차는 고용보험 홈페이지(ei.go.kr) 또는 관할 고용센터에서 확인하세요.</p>
	</article>

	<AdSlot position="middle" />

	<FaqSection items={faqs} />

	<RelatedLinks slug="parental-leave" />

	<AdSlot position="bottom" />
</BaseLayout>

<script>
	import { calcMonthlyParentalLeavePay, calcParentalLeavePay } from '../../lib/parentalLeave.js';
	import { attachCommaFormatting, parseNumber, formatWon } from '../../scripts/number-input.js';

	attachCommaFormatting(document.getElementById('ordinaryWage'));

	const form = document.getElementById('parental-form');
	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const ordinaryWage = parseNumber(document.getElementById('ordinaryWage').value);
		const months = parseNumber(document.getElementById('months').value);

		const result = calcParentalLeavePay({ ordinaryWage, months });

		document.getElementById('r-tier1').textContent = formatWon(calcMonthlyParentalLeavePay(ordinaryWage, 1));
		document.getElementById('r-tier2').textContent = formatWon(calcMonthlyParentalLeavePay(ordinaryWage, 4));
		document.getElementById('r-tier3').textContent = formatWon(calcMonthlyParentalLeavePay(ordinaryWage, 7));
		document.getElementById('r-total').textContent = formatWon(result.totalPay);

		document.getElementById('result').classList.add('is-visible');
		const stamp = document.getElementById('stamp');
		stamp.classList.remove('is-visible');
		void stamp.offsetWidth;
		stamp.classList.add('is-visible');
	});
</script>
