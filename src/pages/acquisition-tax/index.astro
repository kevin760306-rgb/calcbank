---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import FaqSection from '../../components/FaqSection.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { webApplicationJsonLd, faqJsonLd } from '../../utils/seo.js';

const title = '부동산 취득세 계산기 – 2026년 기준 | 머니장부';
const description =
	'주택 취득가액, 보유 주택 수, 조정대상지역 여부에 따른 취득세·지방교육세·농어촌특별세를 계산합니다.';
const pageUrl = new URL('/acquisition-tax/', Astro.site).toString();

const faqs = [
	{
		q: '취득세율은 어떻게 정해지나요?',
		a: '무주택자·1주택자가 유상으로 주택을 매매할 때는 취득가액에 따라 6억원 이하 1%, 6억~9억원 슬라이딩 구간, 9억원 초과 3%의 표준세율이 적용됩니다(지방세법 제11조). 다주택자 중과세율(지방세법 제13조의2)은 지역마다 기준이 달라서, 조정대상지역은 2주택부터, 비조정대상지역은 3주택부터 8%가 적용되고 그다음 단계부터 12%로 오릅니다. "비조정지역이라 다주택도 표준세율"이라고 오해하기 쉬운데, 3주택 이상이면 지역과 무관하게 중과됩니다.',
	},
	{
		q: '지방교육세·농어촌특별세는 무엇인가요?',
		a: '취득세를 낼 때 함께 부과되는 부가세(附加稅)입니다. 표준세율 구간에서는 지방교육세가 취득세액의 10%이며, 전용면적이 85㎡를 초과하면 농어촌특별세(과세표준의 0.2%, 다주택 중과 시 0.6~1.0%)가 추가됩니다. 다주택 중과 구간의 부가세 산정은 사안별로 달라질 수 있어 이 계산기는 근사치로 안내하며, 정확한 금액은 위택스나 관할 지자체에서 확인하는 것이 정확합니다.',
	},
	{
		q: '조정대상지역인지는 어떻게 확인하나요?',
		a: '국토교통부·각 지자체가 지정하는 조정대상지역 목록은 수시로 바뀝니다. 국토교통부 홈페이지나 위택스에서 취득하려는 주택 소재지가 조정대상지역인지 확인해야 정확한 세율을 알 수 있습니다.',
	},
	{
		q: '일시적 2주택이면 나중에 중과세 차액을 돌려받나요?',
		a: '아니요, 반대입니다. 신규 주택을 취득할 때 종전 주택을 3년 안에 처분할 계획이라면(일시적 2주택), 처음부터 중과세가 아니라 1주택 기준 표준세율(1~3%)을 적용받습니다. 문제는 3년 안에 종전 주택을 처분하지 못했을 때인데, 이 경우 애초에 중과세율을 적용받았어야 한다고 보고 차액과 가산세를 추징당합니다. "일단 중과세로 냈다가 나중에 돌려받는" 구조가 아니라는 점을 헷갈리기 쉬우니 주의하세요.',
	},
	{
		q: '생애최초 주택 구입자는 취득세 감면을 받을 수 있나요?',
		a: '일정 요건(소득, 주택가액 등)을 충족하는 생애최초 주택 구입자는 취득세를 최대 200만원까지 감면받을 수 있는 특례가 있습니다. 이 계산기는 표준세율만 계산하므로 감면 대상이라면 실제 납부액은 계산 결과보다 최대 200만원 적을 수 있습니다. 정확한 감면 요건은 관할 시·군·구 세무부서나 위택스에서 확인하세요.',
	},
];

const jsonLd = [
	webApplicationJsonLd({ name: '부동산 취득세 계산기', description, url: pageUrl }),
	faqJsonLd(faqs),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
	<h1>부동산 취득세 계산기</h1>
	<p>취득가액, 보유 주택 수, 조정대상지역 여부와 전용면적을 입력하면 취득세와 부가세를 계산합니다.</p>

	<CalculatorCard no="07" label="ACQUISITION TAX">
		<form id="tax-form">
			<div class="field-grid">
				<div class="field">
					<label for="price">취득가액</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="price" required placeholder="750,000,000" />
						<span class="field__unit">원</span>
					</div>
				</div>
				<div class="field">
					<label for="homeCount">취득 후 보유 주택 수</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="homeCount" required placeholder="1" />
						<span class="field__unit">채</span>
					</div>
				</div>
				<div class="field">
					<label for="exclusiveAreaSqm">전용면적</label>
					<div class="field__control">
						<input type="text" inputmode="numeric" id="exclusiveAreaSqm" required placeholder="84" />
						<span class="field__unit">㎡</span>
					</div>
				</div>
			</div>
			<div class="field" style="margin-top:16px;">
				<label>조정대상지역 여부</label>
				<div class="field-radio-group">
					<label><input type="radio" name="isRegulated" value="no" checked /><span>비조정지역</span></label>
					<label><input type="radio" name="isRegulated" value="yes" /><span>조정대상지역</span></label>
				</div>
			</div>
			<button type="submit" class="btn-calc">취득세 계산하기</button>
		</form>

		<AdSlot position="top" />

		<div class="ledger-result" id="result">
			<div class="ledger-result__row">
				<span class="label">적용 세율</span>
				<span class="value" id="r-rate">-</span>
			</div>
			<div class="ledger-result__row">
				<span class="label">취득세</span>
				<span class="value" id="r-tax">-</span>
			</div>
			<div class="ledger-result__row">
				<span class="label">지방교육세</span>
				<span class="value" id="r-edu">-</span>
			</div>
			<div class="ledger-result__row">
				<span class="label">농어촌특별세</span>
				<span class="value" id="r-rural">-</span>
			</div>
			<div class="ledger-result__row ledger-result__row--total">
				<span class="label">총 납부세액</span>
				<span class="value" id="r-total">-</span>
			</div>
			<div class="result-stamp-wrap">
				<div class="result-stamp" id="stamp">확인</div>
			</div>
		</div>

		<Disclaimer />
	</CalculatorCard>

	<article class="content-section">
		<h2>취득세 계산 방법</h2>
		<p>
			주택을 유상으로 취득하면 취득가액에 취득세율을 곱해 취득세를 계산하고, 여기에 지방교육세와
			(전용면적 85㎡ 초과 시) 농어촌특별세를 더해 최종 납부세액이 정해집니다.
		</p>
		<table>
			<tbody>
				<tr><th>6억원 이하(1주택, 비조정 2주택 이하)</th><td>1%</td></tr>
				<tr><th>6억원 초과 9억원 이하</th><td>(취득가액×2/3억 − 3) / 100 (약 1~3% 슬라이딩)</td></tr>
				<tr><th>9억원 초과</th><td>3%</td></tr>
				<tr><th>조정대상지역 2주택</th><td>8%</td></tr>
				<tr><th>조정대상지역 3주택 이상</th><td>12%</td></tr>
				<tr><th>비조정대상지역 3주택</th><td>8%</td></tr>
				<tr><th>비조정대상지역 4주택 이상</th><td>12%</td></tr>
			</tbody>
		</table>
		<h3>예시로 계산해보면</h3>
		<p>
			취득가액 7억 5천만원, 전용면적 100㎡인 1주택자(비조정지역)라면 세율 2%가 적용되어
			취득세 1,500만원, 지방교육세 150만원(취득세의 10%), 농어촌특별세 150만원(과세표준의
			0.2%)을 더해 총 1,800만원을 납부합니다.
		</p>
		<p>
			같은 비조정대상지역이라도 5억원짜리 주택을 세 번째로 취득한다면 이야기가 달라집니다.
			3주택째부터는 지역과 무관하게 8% 중과세율이 적용되어 취득세만 5억원 × 8% = 4,000만원이고,
			여기에 다주택 중과 시 부과되는 지방교육세·농어촌특별세가 더해집니다. 이 부가세는 사안별로
			산정 방식이 달라질 수 있어 이 계산기는 근사치로만 안내하며, 정확한 금액은 취득 시점에
			관할 지자체나 위택스에서 다시 확인해야 합니다.
		</p>
		<p>
			취득세는 잔금을 치르고 소유권을 넘겨받은 취득일로부터 60일 이내에 신고·납부해야 하며,
			이 기한을 넘기면 무신고·납부지연에 따른 가산세가 붙습니다. 실무에서는 잔금일에 법무사나
			은행이 취득세 신고·납부를 대행해주는 경우가 많아 매수인이 직접 위택스에 접속할 일이
			없는 경우도 흔합니다.
		</p>
	</article>

	<article class="content-section">
		<h2>관련 법령 및 기준</h2>
		<p>
			주택 유상 취득에 대한 표준세율(6억원 이하 1%, 6억~9억원 슬라이딩, 9억원 초과 3%)은
			지방세법 제11조에 근거하며, 다주택자 중과세율은 지방세법 제13조의2에 근거합니다. 이
			조항에 따라 중과가 시작되는 주택 수 기준이 지역마다 다른데, 조정대상지역은 2주택부터
			8%(3주택 이상 12%), 비조정대상지역은 3주택부터 8%(4주택 이상 12%)가 적용됩니다.
			법인이 주택을 취득하는 경우는 주택 수·지역과 무관하게 12%가 적용되지만, 이 계산기는
			개인의 유상 매매 취득만 다루므로 법인 취득에는 사용할 수 없습니다. 지방교육세도 지방세법에
			근거해 함께 부과되고, 농어촌특별세는 별도 법률인 농어촌특별세법에 근거합니다. 생애최초
			주택 구입자 감면, 지방 미분양주택 감면 등 각종 취득세 감면·특례는 지방세법이 아니라
			별도 법률인 지방세특례제한법에 규정되어 있어, 감면 대상 여부는 지방세법상 세율 계산과는
			별개로 확인해야 합니다.
		</p>
	</article>

	<article class="content-section">
		<h2>주의사항</h2>
		<p>다음과 같은 경우엔 실제 납부세액이 이 계산기 결과와 다를 수 있습니다.</p>
		<ul>
			<li>증여 취득(조정대상지역 내 시가표준액 3억원 이상 증여는 12%), 상속 취득(원칙 2.8%, 무주택 가구의 1주택 상속은 별도 특례), 오피스텔 취득(4.6%), 법인의 주택 취득(주택 수·지역과 무관하게 12%)은 이 계산기의 대상이 아닙니다. 유상 매매로 취득하는 개인 주택만 계산합니다.</li>
			<li>생애최초 주택 구입자 감면(최대 200만원), 지방 저가주택 특례 등 각종 한시적·지역별 감면은 반영하지 않았습니다. 감면 대상이라면 실제 납부액은 이 계산기보다 적을 수 있습니다.</li>
			<li>다주택 중과 구간의 지방교육세·농어촌특별세 산정은 사안별로 달라질 수 있어 이 계산기는 근사치만 제공합니다.</li>
			<li>신규 주택 취득 후 3년 안에 종전 주택을 처분하는 일시적 2주택은 처음부터 표준세율을 적용받으므로, 이 계산기가 보여주는 다주택 중과 결과와 실제 납부액이 다를 수 있습니다.</li>
			<li>조정대상지역 지정 여부는 수시로 바뀌므로 취득 시점 기준으로 반드시 다시 확인해야 합니다.</li>
		</ul>
		<p>실제 납부 전에는 반드시 위택스(wetax.go.kr)의 지방세 미리계산 서비스나 관할 시·군·구 세무부서를 통해 정확한 금액을 확인하세요.</p>
	</article>

	<AdSlot position="middle" />

	<FaqSection items={faqs} />

	<RelatedLinks slug="acquisition-tax" />

	<AdSlot position="bottom" />
</BaseLayout>

<script>
	import { calcAcquisitionTax } from '../../lib/acquisitionTax.js';
	import { attachCommaFormatting, parseNumber, formatWon } from '../../scripts/number-input.js';

	attachCommaFormatting(document.getElementById('price'));

	const form = document.getElementById('tax-form');
	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const price = parseNumber(document.getElementById('price').value);
		const homeCount = parseNumber(document.getElementById('homeCount').value) || 1;
		const exclusiveAreaSqm = parseFloat(document.getElementById('exclusiveAreaSqm').value) || 0;
		const isRegulated = form.querySelector('input[name="isRegulated"]:checked').value === 'yes';

		const result = calcAcquisitionTax({ price, homeCount, isRegulated, exclusiveAreaSqm });

		document.getElementById('r-rate').textContent = `${(result.rate * 100).toFixed(2)}%`;
		document.getElementById('r-tax').textContent = formatWon(result.acquisitionTax);
		document.getElementById('r-edu').textContent = formatWon(result.localEducationTax);
		document.getElementById('r-rural').textContent = formatWon(result.ruralSpecialTax);
		document.getElementById('r-total').textContent = formatWon(result.totalTax);

		document.getElementById('result').classList.add('is-visible');
		const stamp = document.getElementById('stamp');
		stamp.classList.remove('is-visible');
		void stamp.offsetWidth;
		stamp.classList.add('is-visible');
	});
</script>
